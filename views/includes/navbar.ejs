<style>
  .btn-search {
    background-color: #fe424d;
    color: white;
    white-space: nowrap;
    border-radius: 25px;
    padding: 0 1rem;
  }

  .btn-search:hover {
    background-color: #fe424d;
    color: white;
  }

  .btn-search i {
    margin-right: 0.5rem;
  }

  .search-input {
    border-radius: 25px;
    padding: 0.5rem 2rem;
    font-size: 1rem;
  }

  @media (max-width: 991.98px) {
    .navbar-search {
      display: none !important;
    }

    #navbarNavAltMarkup {
      position: absolute;
      top: 100%;
      right: 0;
      width: 220px;
      background-color: white;
      padding: 0.75rem 1rem;
      border: 1px solid #ddd;
      border-top: none;
      border-radius: 0 0 0 0.75rem;
      box-shadow: 0 4px 10px rgba(0, 0, 0, 0.1);
    }

    #navbarNavAltMarkup .navbar-nav {
      align-items: flex-end;
    }

    #navbarNavAltMarkup .nav-link {
      width: 100%;
      text-align: right;
      padding: 0.5rem 0;
    }
  }
</style>

<nav class="navbar navbar-expand-lg bg-body-light border-bottom sticky-top">
  <div class="container-fluid">

    <a class="navbar-brand" href="/listings">
      <i class="fa-regular fa-compass"></i>
    </a>

    <button
      class="navbar-toggler"
      type="button"
      data-bs-toggle="collapse"
      data-bs-target="#navbarNavAltMarkup"
      aria-controls="navbarNavAltMarkup"
      aria-expanded="false"
      aria-label="Toggle navigation"
    >
      <span class="navbar-toggler-icon"></span>
    </button>

    <div class="collapse navbar-collapse" id="navbarNavAltMarkup">

      <div class="navbar-nav">
        <a class="nav-link" href="/listings">
          Explore
        </a>
      </div>

      <form class="d-flex ms-lg-auto navbar-search" role="search">
        <input
          class="form-control me-2 search-input"
          type="search"
          placeholder="Search destinations"
          aria-label="Search"
        >

        <button class="btn btn-search" type="submit">
          <i class="fa-solid fa-magnifying-glass"></i>
          Search
        </button>
      </form>

      <div class="navbar-nav ms-lg-auto">

        <a class="nav-link" href="/listings/new">
          Start Hosting
        </a>

        <% if (!currUser) { %>

          <a class="nav-link" href="/signup">
            <b>Signup</b>
          </a>

          <a class="nav-link" href="/login">
            <b>Login</b>
          </a>

        <% } else { %>

          <a class="nav-link" href="/logout">
            <b>Logout</b>
          </a>

        <% } %>

      </div>

    </div>

  </div>
</nav>